# =============================================================================
# ZR APP · PLANTILLA DE VARIABLES DE ENTORNO
# =============================================================================
# Este archivo SÍ se sube al repositorio. Nunca lleva valores reales.
#
# Para trabajar en local:
#   1. Copia este archivo a .env.local
#   2. Levanta la base:  supabase start
#   3. Pega en .env.local las claves que ese comando imprime
#
# .env.local está en .gitignore y NUNCA se sube.
# Las claves de producción se comparten por el gestor de contraseñas
# (Bitwarden), jamás por WhatsApp, correo ni chat. Ver COLABORACION.md §2 paso 4.
# =============================================================================

# URL de la API de Supabase.
# En local siempre es esta. En producción, la del proyecto en supabase.com.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública. Viaja al navegador a propósito: por sí sola no da acceso a
# nada, porque Row Level Security decide qué puede leer cada usuario.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ CLAVE DE SERVICIO — SE SALTA ROW LEVEL SECURITY POR COMPLETO.
#
# NO lleva el prefijo NEXT_PUBLIC_ y eso es deliberado: si lo llevara, Next.js
# la incluiría en el paquete que descarga el navegador y cualquiera con las
# herramientas de desarrollo podría leer y escribir TODA la base, incluidos los
# datos personales de los estudiantes menores de edad.
#
# Úsala solo en Edge Functions y en rutas de servidor. Nunca en un componente
# de cliente. El flujo de CI falla a propósito si aparece en .next/static/.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la aplicación.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Notificaciones Web Push (hacen falta a partir de T-408, Sprint 4)
# -----------------------------------------------------------------------------
# Se generan una sola vez con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
